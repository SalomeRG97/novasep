# ============================================================
#  NOVASEP — URLs limpias y optimización de servidor
#  Versión: 1.0.0
# ============================================================

# Activar motor de reescritura
RewriteEngine On

# ----------------------------------------------------------
#  1. Forzar HTTPS (descomentar cuando el certificado SSL esté activo)
# ----------------------------------------------------------
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ----------------------------------------------------------
#  2. Forzar www (descomentar si se desea www canónico)
# ----------------------------------------------------------
# RewriteCond %{HTTP_HOST} ^novaseguridad\.com\.co$ [NC]
# RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ----------------------------------------------------------
#  3. Redirigir index.html a la raíz
# ----------------------------------------------------------
RewriteRule ^index\.html$ / [R=301,L]

# ----------------------------------------------------------
#  4. Redirigir URLs con .html a URLs limpias (301 permanente)
#     Ejemplo: /quienes-somos.html → /quienes-somos
# ----------------------------------------------------------
RewriteCond %{THE_REQUEST} /([^.]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ----------------------------------------------------------
#  5. Servir internamente el archivo .html para URLs limpias
#     Ejemplo: /quienes-somos → quienes-somos.html (interno)
# ----------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# ----------------------------------------------------------
#  6. Página de error 404 personalizada (opcional)
# ----------------------------------------------------------
# ErrorDocument 404 /404.html

# ----------------------------------------------------------
#  7. Caché de archivos estáticos (mejora rendimiento)
# ----------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/json "access plus 1 month"
</IfModule>

# ----------------------------------------------------------
#  8. Compresión GZIP (reduce tamaño de transferencia)
# ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ----------------------------------------------------------
#  9. Cabeceras de seguridad
# ----------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
