# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Node (if using build tools in the future)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Build output
dist/
build/
.cache/
.parcel-cache/

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log

# Temporary files
*.tmp
*.temp
.temp/
tmp/

# Gemini / AI agent workspace
.gemini/
.agents/
